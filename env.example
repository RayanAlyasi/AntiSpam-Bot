# AntiSpam Bot environment (DESIGN.md §19.1). Copy it to .env and fill in what you need:
#   cp env.example .env
# Everything except POSTGRES_PASSWORD is optional: the bot starts with safe defaults.
# Settings that aren't secrets or deployment-specific (pacing, presets, scoring) live in the
# optional config.yaml instead (see config.example.yaml); the AI_* variables override it.

# --- Database -------------------------------------------------------------------------------

# Password for the bundled Postgres. Required by docker-compose.yml, which builds DATABASE_URL
# from it, so it must be URL-safe: use letters and digits, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Postgres connection string. Only for running the binary without docker-compose.yml: under
# compose, the value set in docker-compose.yml wins (edit it there to use an external Postgres).
# DATABASE_URL=postgres://antispam:<password>@localhost:5432/antispam?sslmode=disable

# --- Instance -------------------------------------------------------------------------------

# Phone numbers with the operator role (pairing, instance-wide blacklist, alerts),
# comma-separated, in international format.
OPERATOR_PHONES=

# Where the website and API are reachable from outside, e.g. https://antispam.example.com.
# Used in links the bot sends. Leave empty if you don't expose it.
PUBLIC_URL=

# Listen address for the API, /metrics, /healthz and /readyz. The container healthcheck
# probes /healthz on this port. docker-compose.yml sets ":8080".
# HTTP_ADDR=:8080

# Log level: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# Path to the optional config file. Default: config.yaml in the working directory; a missing
# default file just means defaults.
# CONFIG_FILE=/config/config.yaml

# --- AI check (optional) --------------------------------------------------------------------
# Without AI_PROVIDER the AI tier stays off, and messages that are suspicious but not certain
# go to the admins instead (DESIGN.md §7.0). When it's on, only those uncertain messages are
# sent to the provider, so their text leaves your server unless you run a local model.

# anthropic or openai_compatible (OpenAI, Ollama, llama.cpp, vLLM, LM Studio, ...).
# google is accepted by the configuration but has no adapter in v0.1.
# AI_PROVIDER=
# Base URL of the API. Required for openai_compatible, e.g. http://ollama:11434/v1.
# AI_BASE_URL=
# Model name. Required when AI_PROVIDER is set, e.g. claude-haiku-5-5.
# AI_MODEL=
# API key. Required for anthropic and google; optional for local servers. Never put it in
# config.yaml (ai.api_key_env names this variable; default AI_API_KEY).
# AI_API_KEY=
# Per-request timeout. Default: 5s.
# AI_TIMEOUT=5s
