#!/bin/sh
# Second lock behind the Claude Code commit guard: refuses commits without a judge stamp.
# Humans committing their own work can bypass this with `git commit --no-verify`.
root=$(git rev-parse --show-toplevel)
exec python3 - "$root" <<'PY'
import sys
sys.path.insert(0, sys.argv[1] + "/harness/scripts")
import hooklib as h
ok, reason = h.stamp_status(sys.argv[1])
if not ok:
    sys.stderr.write("pre-commit: " + reason + "\n(Human commit? Use git commit --no-verify.)\n")
    sys.exit(1)
PY
