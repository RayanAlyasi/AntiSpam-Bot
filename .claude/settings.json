{
  "model": "opus",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "TZ": "UTC"
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go doc *)",
      "Bash(go list *)",
      "Bash(go mod tidy)",
      "Bash(go get *)",
      "Bash(go run *)",
      "Bash(go tool *)",
      "Bash(go env *)",
      "Bash(make *)",
      "Bash(gofumpt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint *)",
      "Bash(go-arch-lint *)",
      "Bash(sqlc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin feat/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(harness/scripts/*)",
      "Bash(docker compose *)"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Agent(Explore)",
      "Read(./auth_info_baileys/**)",
      "Read(./whatsapp_logs.db)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge *)",
      "Bash(git push origin main*)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-go.sh", "timeout": 60 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "judge",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stamp.py", "timeout": 900 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_gate.py", "timeout": 900 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_end.py", "timeout": 30 }
        ]
      }
    ]
  }
}
